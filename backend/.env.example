# Copy to .env and fill in. .env is gitignored.

# Local dev: use a separate local database. Never seed the production database.
# Production (Railway): the platform injects DATABASE_URL automatically.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/wec_development

ENVIRONMENT=development

# API overload protection. Keep API_MAX_CONCURRENCY below the total
# SQLAlchemy pool capacity (DB_POOL_SIZE + DB_MAX_OVERFLOW).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=5
API_MAX_CONCURRENCY=12
API_ADMISSION_TIMEOUT_SECONDS=1.5
API_RETRY_AFTER_SECONDS=2

# Optional scheduler override. Railway enables adaptive ingestion automatically
# for the service named `wec-cron`; set false for a one-shot diagnostic run.
# ADAPTIVE_INGEST=false
